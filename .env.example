PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
INVITE_TOKEN=replace-with-a-long-random-invite-token
GUEST_PASSWORD=replace-with-a-guest-password
HOST_PASSWORD=replace-with-a-separate-host-password
